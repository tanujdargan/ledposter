# Runs as root when ledposter-net-rollback.timer elapses, and at boot while the note exists
# (a reboot inside the 120s window must not leave an unconfirmed static IP in place: the
# timer is not persistent). Reads $LEDPOSTER_DATA/net-rollback (written by the web app before
# applying a static IP, read back without following symlinks) and puts that connection back
# on DHCP. A missing file means the address was confirmed: nothing happens.
[Unit]
Description=Put the LED wall back on DHCP (unconfirmed static IP)
ConditionPathExists=/data/net-rollback
After=NetworkManager.service data.mount
Wants=NetworkManager.service

[Service]
Type=oneshot
Environment=LEDPOSTER_DATA=/data
ExecStart=/usr/local/bin/ledposter-net rollback

[Install]
WantedBy=multi-user.target
