# The web app (FastAPI, port 80). Runs as the unprivileged ledwall user with only the
# capability to bind port 80; root-needing actions go through fixed units via polkit
# (system/polkit). Independent of the engine: either one can crash and come back alone.
# Ordered after the engine so the first thing it does is restore the last mode, but it must
# never wait for the network (network-online.target would stall on a wall with no Wi-Fi yet).
# Installed by system/install.sh.
[Unit]
Description=LED wall web app
RequiresMountsFor=/data
After=network.target ledposter-engine.service
Wants=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ledwall
Group=ledwall
Environment=LEDPOSTER_DATA=/data PYTHONUNBUFFERED=1 HOME=/data/app
# /data/app is root's: let `git describe` (Settings > Software) read it without "dubious ownership"
Environment=GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=safe.directory GIT_CONFIG_VALUE_0=*
WorkingDirectory=/data/app/current/web
ExecStart=/data/app/current/web/.venv/bin/python -m ledposter
Restart=always
RestartSec=2
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/data
PrivateTmp=yes
ProtectHome=yes
TimeoutStopSec=10
# Off the panel refresh's way: never on core 3 (the matrix library's refresh thread; isolcpus
# keeps it there too, this makes it explicit), and the lowest CPU and I/O priority, which
# ffmpeg transcodes inherit. With the web app running the panels flickered visibly more (A/B
# by eye, 2026-10-17).
CPUAffinity=0-2
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
