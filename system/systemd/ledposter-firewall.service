# Applies the ufw rules the web app generated into /data/firewall.rules (ledposter.system
# .firewall_rules: HTTP, mDNS, DDP/E1.31 only when enabled, SSH only when on, the hotspot's
# DHCP/DNS on the Wi-Fi interface). Runs at every boot, since ufw's own saved rules are on
# the overlay, and whenever the app starts it after a change (polkit lets the ledposter user
# start exactly this unit). Installed by system/install.sh.
[Unit]
Description=LED wall firewall rules (ufw)
RequiresMountsFor=/data
After=ufw.service network-pre.target

[Service]
Type=oneshot
Environment=LEDPOSTER_DATA=/data
ExecStart=/usr/local/bin/ledposter-sys firewall

[Install]
WantedBy=multi-user.target
