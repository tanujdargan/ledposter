# Software update with rollback (web/ledposter/updater.py). Started by the web app after it
# wrote /data/update-request.json (polkit allows the ledposter user to start this unit), and
# at every boot to finish a switch a power cut interrupted (health check, or roll back) or to
# redo an interrupted build. Runs as root: /data/app (releases, current/previous, deploy key)
# is root's so the web app cannot swap what the root-run engine executes. The request file is
# read without following symlinks and its tag is checked against the repository's tags; the
# clone runs as root (deploy key), make/venv/pip/tests as the unprivileged ledposter-build
# user, then root takes the release over and marks it ready (docs/DEVIATIONS.md). Low
# priority so the wall keeps its frame rate while the engine compiles. Installed by
# system/install.sh.
[Unit]
Description=LED wall software update
RequiresMountsFor=/data
After=ledposter-engine.service ledposter-web.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=LEDPOSTER_DATA=/data HOME=/data/app
ExecStart=/usr/bin/python3 /data/app/current/web/ledposter/updater.py run
Nice=19
IOSchedulingClass=idle
TimeoutStartSec=2h
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
